#!/usr/bin/env bash
# Boot hook for the python mixin (lifecycle startup, runs in the background).
#
# 1. Socket Firewall aliases for pip and uv in bash. A mixin can only add
#    files, and these two files belong to the workload, so append once.
# 2. Once the sandbox's Docker daemon answers, start the shared test services.
set -uo pipefail

state="$HOME/.local/state/python-kit"
mkdir -p "$state"
exec >>"$state/services.log" 2>&1
echo "$(date -Is) boot"

marker="# python-kit: Socket Firewall for pip and uv"
aliases="$marker
shopt -s expand_aliases
alias pip=\"sfw pip\"
alias pip3=\"sfw pip3\"
alias uv=\"sfw uv\""
for rc in /etc/sandbox-persistent.sh "$HOME/.bashrc"; do
  if [ -w "$rc" ] && ! grep -qF "$marker" "$rc"; then
    printf '\n%s\n' "$aliases" >>"$rc"
    echo "Added sfw aliases to $rc"
  fi
done

# The daemon comes up with the sandbox, but not necessarily before this hook.
for _ in $(seq 1 120); do
  docker info >/dev/null 2>&1 && break
  sleep 2
done
if ! docker info >/dev/null 2>&1; then
  echo "Docker daemon did not answer within 4 minutes; run sandbox-services start by hand."
  exit 1
fi

/usr/local/bin/sandbox-services start
