#!/usr/bin/env bash
# Runs the shared test services (Postgres, Redis) on the sandbox's own Docker
# daemon. One set serves every worktree; tests isolate themselves with
# WORKTREE_ID (see with-worktree-env).
#
#   sandbox-services start    start what's missing; a running service is left alone
#   sandbox-services stop     stop the containers (data stays in the volumes)
#   sandbox-services status   one line per service; exits 1 if any is down
#
# The services and image tags come from /etc/python-kit/services.env, written
# from the kit args. SANDBOX_SERVICES overrides the list for one call.
set -euo pipefail

conf=/etc/python-kit/services.env
SERVICES=postgres
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
# shellcheck source=/dev/null
[ -r "$conf" ] && . "$conf"
SERVICES="${SANDBOX_SERVICES:-$SERVICES}"

# Known, local-only credentials. The ports bind to the sandbox's loopback.
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres
PG_USER=dev
PG_PASS=dev
PG_DB=dev

usage() { sed -n '2,13s/^# \{0,1\}//p' "$0"; }

services() { tr ',' '\n' <<<"$SERVICES" | sed 's/[[:space:]]//g' | grep -v '^$'; }

container() { printf 'sandbox-%s' "$1"; }

running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$(container "$1")" 2>/dev/null)" = true ]
}

pg_ready() {
  docker exec "$(container postgres)" pg_isready -q -h 127.0.0.1 -U "$PG_SUPERUSER" >/dev/null 2>&1
}

redis_ready() {
  [ "$(docker exec "$(container redis)" redis-cli ping 2>/dev/null)" = PONG ]
}

ready() {
  case "$1" in
    postgres) pg_ready ;;
    redis) redis_ready ;;
  esac
}

wait_ready() {
  for _ in $(seq 1 60); do
    ready "$1" && return 0
    sleep 1
  done
  echo "$1 did not become ready within 60 s; see: docker logs $(container "$1")" >&2
  return 1
}

# The role test runners use: it logs in with a password and may create
# databases (test_<name> for every alias), but is not a superuser.
ensure_pg_role() {
  docker exec -i "$(container postgres)" psql -v ON_ERROR_STOP=1 -q -U "$PG_SUPERUSER" -d postgres <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$PG_USER') THEN
    CREATE ROLE $PG_USER LOGIN PASSWORD '$PG_PASS' CREATEDB;
  END IF;
END
\$\$;
SELECT 'CREATE DATABASE $PG_DB OWNER $PG_USER'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '$PG_DB')\gexec
SQL
}

# run_container <service> <image> [docker run options...]
run_container() {
  local name="$1" image="$2"
  shift 2
  if docker inspect "$(container "$name")" >/dev/null 2>&1; then
    docker start "$(container "$name")" >/dev/null
  else
    docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null
    docker run -d --name "$(container "$name")" --restart unless-stopped "$@" "$image" >/dev/null
  fi
}

start_one() {
  case "$1" in
    postgres)
      if ! running postgres; then
        echo "Starting postgres ($POSTGRES_IMAGE) on 127.0.0.1:5432"
        # Postgres 18 images keep data under /var/lib/postgresql/<major>;
        # older ones declare /var/lib/postgresql/data as the volume.
        local major data=/var/lib/postgresql
        major="$(sed -E 's/^[^:]*:([0-9]+).*/\1/' <<<"$POSTGRES_IMAGE")"
        if [[ "$major" =~ ^[0-9]+$ ]] && [ "$major" -lt 18 ]; then
          data=/var/lib/postgresql/data
        fi
        run_container postgres "$POSTGRES_IMAGE" \
          -p 127.0.0.1:5432:5432 \
          -v "sandbox-postgres-data:$data" \
          -e POSTGRES_USER="$PG_SUPERUSER" \
          -e POSTGRES_PASSWORD="$PG_SUPERPASS"
      fi
      wait_ready postgres
      ensure_pg_role
      ;;
    redis)
      if ! running redis; then
        echo "Starting redis ($REDIS_IMAGE) on 127.0.0.1:6379"
        run_container redis "$REDIS_IMAGE" \
          -p 127.0.0.1:6379:6379 \
          -v sandbox-redis-data:/data
      fi
      wait_ready redis
      ;;
    *)
      echo "Unknown service: $1 (expected postgres or redis)" >&2
      return 1
      ;;
  esac
}

cmd_start() {
  # Two callers at once (the boot hook and an agent) would race on docker run.
  local lock_dir="${XDG_STATE_HOME:-$HOME/.local/state}/python-kit"
  mkdir -p "$lock_dir"
  exec 9>"$lock_dir/services.lock"
  flock 9
  local s
  for s in $(services); do
    start_one "$s"
  done
  cmd_status
}

cmd_stop() {
  local s
  for s in $(services); do
    if running "$s"; then
      docker stop "$(container "$s")" >/dev/null
      echo "Stopped $s"
    fi
  done
}

cmd_status() {
  local s down=0
  for s in $(services); do
    if running "$s" && ready "$s"; then
      case "$s" in
        postgres) echo "postgres  up  postgres://$PG_USER:$PG_PASS@127.0.0.1:5432/$PG_DB" ;;
        redis) echo "redis     up  redis://127.0.0.1:6379/0" ;;
      esac
    else
      printf '%-9s down\n' "$s"
      down=1
    fi
  done
  return "$down"
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
