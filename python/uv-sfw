#!/bin/sh
# /usr/local/bin/uv and /usr/local/bin/uvx: run the real binary through
# Socket Firewall, so every package download is checked, with or without a
# shell. The real binaries come first on PATH, so sfw resolves uv to them and
# not back to this wrapper.
#
# `uv run --no-sync` and `uv run --offline` (or UV_NO_SYNC / UV_OFFLINE) can't
# download, so they skip sfw: tests and linters then run without its proxy in
# their environment, and a timeout signals them, not sfw. Put the flag right
# after `run`.
#
# `uv run`, `sync`, `add` and `remove` refuse to touch an environment whose
# interpreter doesn't exist here, such as a macOS .venv in a checkout mounted
# from the host: uv would delete it and build a Linux one, breaking the
# host's environment. The environment is the one uv picks: $VIRTUAL_ENV with
# --active, or else UV_PROJECT_ENVIRONMENT (relative to the workspace root) or
# .venv at the root of the workspace that --project, --directory, UV_PROJECT
# or the current directory selects. A script with inline metadata
# (`# /// script`) gets an environment of its own, so it's left alone. Set
# UV_PROJECT_ENVIRONMENT to a new directory to keep a separate environment.
real=/usr/local/lib/python-kit/bin
tool="$(basename "$0")"

# For `uv run|sync|add|remove`, prints the environment uv would use when its
# interpreter is missing. Only the options that pick the project reach
# `uv workspace dir`, which finds the workspace root without resolving.
foreign_venv() {
  end=__uv_sfw_end__
  cmd= active= target= dir=.
  set -- "$@" "$end"
  while [ "$1" != "$end" ]; do
    arg="$1"; shift
    case "$arg" in
      --)
        [ "$cmd" = run ] && [ "$1" != "$end" ] && target="$1"
        break ;;
      --project) [ "$1" = "$end" ] || { set -- "$@" "$arg" "$1"; shift; } ;;
      --directory) [ "$1" = "$end" ] || { dir="$1"; set -- "$@" "$arg" "$1"; shift; } ;;
      --project=*) set -- "$@" "$arg" ;;
      --directory=*) dir="${arg#*=}"; set -- "$@" "$arg" ;;
      --active) active=1 ;;
      --no-project) return 1 ;;
      # `uv run --script` is a flag: the command is the script. The other
      # commands take the script as its value and work on its own
      # environment.
      --script) [ "$cmd" = run ] || return 1 ;;
      # Options whose value is a separate word, so it isn't taken for the
      # subcommand or for the command `uv run` runs.
      --cache-dir | --config-file | --color | --python | -p | --package | \
        --extra | --group | --no-group | --only-group | --index | \
        --default-index | --index-url | --extra-index-url | --find-links | -f | \
        --with | --with-editable | --with-requirements | --env-file | \
        --requirements | -r | --constraints | -c | --optional | --dev-group | \
        --tag | --branch | --rev | --python-platform | --exclude-newer)
        [ "$1" = "$end" ] || shift ;;
      -*) ;;
      *)
        if [ -z "$cmd" ]; then
          cmd="$arg"
          case "$cmd" in run | sync | add | remove) ;; *) return 1 ;; esac
        elif [ "$cmd" = run ]; then
          target="$arg"
          break # the command uv runs; its arguments aren't uv's
        fi
        ;;
    esac
  done
  [ -n "$cmd" ] || return 1
  while [ "$1" != "$end" ]; do shift; done
  shift
  # A script with inline metadata runs in its own environment.
  if [ -n "$target" ]; then
    case "$target" in /*) file="$target" ;; *) file="$dir/$target" ;; esac
    [ -f "$file" ] && grep -q '^# /// script$' "$file" && return 1
  fi
  if [ -n "$active" ] && [ -n "${VIRTUAL_ENV:-}" ]; then
    venv="$VIRTUAL_ENV"
  else
    root="$("$real/uv" workspace dir "$@" 2>/dev/null)" || return 1
    case "${UV_PROJECT_ENVIRONMENT:-}" in
      "") venv="$root/.venv" ;;
      /*) venv="$UV_PROJECT_ENVIRONMENT" ;;
      *) venv="$root/$UV_PROJECT_ENVIRONMENT" ;;
    esac
  fi
  [ -f "$venv/pyvenv.cfg" ] || return 1
  home="$(sed -n 's/^home *= *//p' "$venv/pyvenv.cfg" | head -n 1)"
  [ -n "$home" ] && [ ! -d "$home" ] && echo "$venv"
}

if [ "$tool" = uv ] && venv="$(foreign_venv "$@")"; then
  echo "uv: $venv was made by an interpreter that isn't in this sandbox (probably the host's), so uv would replace it and break it there." >&2
  echo "Run uv in a factory worktree, or set UV_PROJECT_ENVIRONMENT to a new directory (for example .venv-sandbox) to keep a separate environment." >&2
  exit 2
fi

if [ "$tool" = uv ] && [ "${1:-}" = run ]; then
  case "${UV_NO_SYNC:-}${UV_OFFLINE:-}" in ?*) exec "$real/uv" "$@" ;; esac
  for arg in "$@"; do
    case "$arg" in
      run) ;;
      --no-sync | --offline) exec "$real/uv" "$@" ;;
      -*) ;;
      *) break ;;
    esac
  done
fi

sfw="$(command -v sfw)" || {
  echo "$tool: sfw not found; run $real/$tool to skip Socket Firewall" >&2
  exit 127
}
PATH="$real:$PATH" exec "$sfw" "$tool" "$@"
