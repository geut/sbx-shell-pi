#!/usr/bin/env bash
# collect-packages <out-dir> <floor-file> <package>...   (build time only)
#
# Copies into <out-dir> every file of the given installed packages and of their
# whole Depends/Pre-Depends closure, so the mixin works on a workload whose
# base lacks them. Packages listed in <floor-file> (one name per line: the
# plain ubuntu image's packages, libc6, coreutils, ...) and Essential packages
# are skipped: every workload on that release has them, and they must stay its
# own. Priority can't tell: Ubuntu 26.04 marks libc6 "optional". Documentation
# is left out.
#
# Not the base's package list: the workload can remove packages its base had
# (the factory's apt-get autoremove drops gcc), so "new since the base" is
# not enough.
#
# Alternatives (/usr/bin/cc -> /etc/alternatives/cc -> gcc) live outside dpkg's
# file lists, so links that resolve into the copied files are copied too.
set -euo pipefail

out="$1"
floor="$2"
shift 2

apt-cache depends --recurse --installed \
    --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances \
    "$@" \
  | grep -v '^ ' | grep -v '^<' | sort -u > /tmp/closure

: > /tmp/packages
while IFS= read -r pkg; do
  # Alternatives that weren't chosen (make-guile for make) are known to dpkg
  # but not installed.
  info="$(dpkg-query -W -f='${db:Status-Status} ${Priority} ${Essential}' "$pkg" 2>/dev/null || true)"
  case "$info" in
    installed\ *\ yes) continue ;;
    installed\ *) ;;
    *) continue ;;
  esac
  grep -qxF "${pkg%%:*}" "$floor" && continue
  printf '%s\n' "$pkg" >> /tmp/packages
done < /tmp/closure
echo "Copying $(wc -l < /tmp/packages) packages:" && tr '\n' ' ' < /tmp/packages && echo

xargs -a /tmp/packages dpkg -L | sort -u \
  | grep -vE '^/usr/share/(doc|info|lintian|locale)/|/man/' \
  | while IFS= read -r path; do
      # Merged /usr: /bin, /lib, /sbin are symlinks into /usr. Resolve the
      # directory so the layer never holds a real /bin that would replace them.
      if [ -L "$path" ] || [ -f "$path" ]; then
        printf '%s/%s\n' "$(readlink -f "$(dirname "$path")")" "$(basename "$path")"
      fi
    done | sort -u > /tmp/files

# /etc/alternatives/<name> whose target is one of the files, and every
# symlink in a bin directory that points at such an alternative.
: > /tmp/alternatives
for alt in /etc/alternatives/*; do
  target="$(readlink -f "$alt" || true)"
  if [ -n "$target" ] && grep -qxF "$target" /tmp/files; then
    printf '%s\n' "$alt" >> /tmp/alternatives
  fi
done
find /usr/bin /usr/sbin /bin /sbin -type l -lname '/etc/alternatives/*' 2>/dev/null \
  | while IFS= read -r link; do
      if grep -qxF "$(readlink "$link")" /tmp/alternatives; then printf '%s\n' "$link"; fi
    done >> /tmp/alternatives

mkdir -p "$out"
cat /tmp/files /tmp/alternatives | sort -u | tar -cf - --no-recursion -T - | tar -xf - -C "$out"
echo "Copied $(wc -l < /tmp/files) files and $(wc -l < /tmp/alternatives) alternative links."
