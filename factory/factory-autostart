#!/usr/bin/env bash
# Boot hook: brings the factory server back after the sandbox restarts.
# factory serve must run in a Herdr pane, and Herdr is the entrypoint, so wait
# for Herdr to answer, then run factory-up for each repository where it ran
# before: the ones it recorded in ~/.local/state/factory/roots, and the
# workspace. Only a repository with .factory/dashboard.env is started.
set -uo pipefail

export PATH="$HOME/.hunk/bin:$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

state="$HOME/.local/state/factory"
mkdir -p "$state"
exec >>"$state/autostart.log" 2>&1
echo "$(date -Is) boot"

roots=()
declare -A seen=()
while IFS= read -r root; do
  [ -n "$root" ] && [ -z "${seen[$root]:-}" ] || continue
  seen[$root]=1
  if [ -f "$root/.factory/dashboard.env" ]; then
    roots+=("$root")
  else
    echo "factory-up never ran in $root; skipping it."
  fi
done < <(cat "$state/roots" 2>/dev/null; echo "${WORKSPACE_DIR:-$HOME/workspace}")

if [ "${#roots[@]}" -eq 0 ]; then
  echo "Nothing to start."
  exit 0
fi

# Herdr starts when a client attaches, which can be long after boot.
until herdr workspace list >/dev/null 2>&1; do
  sleep 2
done

for root in "${roots[@]}"; do
  echo "factory-up $root"
  factory-up "$root"
done
