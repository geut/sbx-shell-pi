#!/usr/bin/env bash
# Boot hook: brings the factory server back after the sandbox restarts.
# factory serve must run in a Herdr pane, and Herdr is the entrypoint, so wait
# for Herdr to answer, then run factory-up for the workspace. Only a workspace
# where factory-up ran before (it leaves .factory/dashboard.env) is started.
set -uo pipefail

export PATH="$HOME/.hunk/bin:$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

root="${WORKSPACE_DIR:-$HOME/workspace}"
state="$HOME/.local/state/factory"
mkdir -p "$state"
exec >>"$state/autostart.log" 2>&1
echo "$(date -Is) boot: $root"

if [ ! -f "$root/.factory/dashboard.env" ]; then
  echo "factory-up never ran in $root; nothing to start."
  exit 0
fi

# Herdr starts when a client attaches, which can be long after boot.
until herdr workspace list >/dev/null 2>&1; do
  sleep 2
done

factory-up "$root"
